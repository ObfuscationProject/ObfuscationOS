OKMOD
name=system-notes
version=1
vermagic=okernel-cxx-oop
require=gui.compositor
require=gui.desktop
require=gui.system-desktop
export=gui.app.notes
param=entry:oop
param=class:app
param=title:Notes
param=subtitle:tiny-c notes scratchpad
param=body:Window surface owned by an OS module
param=command:/bin/cat /etc/os-release
param=line1:notes are staged from rootfs
param=line2:CLI tools use libokcrt
param=x:520
param=y:278
param=width:346
param=height:150
param=accent:rose
signature=system-notes-dev
