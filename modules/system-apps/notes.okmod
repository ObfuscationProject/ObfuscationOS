OKMOD
name=system-notes
version=1
vermagic=okernel-cxx-oop
require=gui.compositor
require=gui.desktop
require=gui.system-desktop
export=gui.app.notes
param=entry:oop
param=class:app
param=title:Notes
param=subtitle:small native GUI scratchpad
param=body:Window surface owned by an OS module
param=x:182
param=y:124
param=accent:rose
signature=system-notes-dev
