OKMOD
name=system-tasks
version=1
vermagic=okernel-cxx-oop
require=gui.compositor
require=gui.desktop
require=gui.system-desktop
export=gui.app.tasks
param=entry:oop
param=class:app
param=title:Task Manager
param=subtitle:system process overview
param=body:Live scheduler snapshot
param=command:/bin/uptime
param=line3:kernel apps stay outside System dock
param=x:64
param=y:282
param=width:346
param=height:150
param=accent:violet
signature=system-tasks-dev
