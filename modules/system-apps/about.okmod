OKMOD
name=system-about
version=1
vermagic=okernel-cxx-oop
require=gui.compositor
require=gui.desktop
require=gui.system-desktop
export=gui.app.about
param=entry:oop
param=class:app
param=title:About ObfuscationOS
param=subtitle:tiny-c app package
param=body:ObfuscationOS userland desktop
param=command:/bin/uname
param=line1:loaded with OK_SYS_LOAD_MODULE
param=line2:rootfs package facade
param=x:300
param=y:168
param=width:336
param=height:154
param=accent:gold
signature=system-about-dev
