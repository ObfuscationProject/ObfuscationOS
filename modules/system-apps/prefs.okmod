OKMOD
name=system-prefs
version=1
vermagic=okernel-cxx-oop
require=gui.compositor
require=gui.desktop
require=gui.system-desktop
export=gui.app.prefs
param=entry:oop
param=class:app
param=title:System Preferences
param=subtitle:display and session sketch
param=body:Palette, input, and desktop state
param=x:118
param=y:84
param=accent:blue
signature=system-prefs-dev
