# BusyBox 1.37.0 applet selection for the static musl userland (decision 0004).
# tools/ports.py merges these lines over `make allnoconfig`; every other boolean
# stays off unless a requested symbol selects it, and a resolved .config that
# drops any symbol requested here is refused.
#
# Applets are selected only when every syscall they need on their main path is
# routed by the kernel Linux personality. These stay on okcrt in /bin until the
# kernel routes the listed calls:
#   sync (sync; decision 0001 keeps the okcrt one)
#   df (statfs)  mkfifo/mknod (mknodat)  ps/top/free/kill-by-name (/proc)
# Job control (ASH_JOB_CONTROL) and line editing wait for kernel termios and
# sessions on a PTY (WT2.2).

CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
# Usage text is stored bzip2-compressed.
CONFIG_FEATURE_COMPRESS_USAGE=y
CONFIG_BUSYBOX=y
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
CONFIG_FEATURE_BUFFERS_GO_ON_STACK=y
CONFIG_FEATURE_COPYBUF_KB=4
CONFIG_FEATURE_HUMAN_READABLE=y

# Shell
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_RANDOM_SUPPORT=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
